{
  "name": "prodigi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync:plapps-env": "node scripts/sync-plapps-env.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test",
    "test:coverage": "vitest run --coverage --coverage.include='lib/**/*.ts' --coverage.exclude='lib/**/*.test.ts'",
    "test:coverage:gate": "vitest run --coverage --coverage.include='lib/**/*.ts' --coverage.exclude='lib/**/*.test.ts' --coverage.thresholds.lines=10",
    "db:pull-baseline": "node scripts/pull-live-baseline.mjs",
    "db:probe-read-rpcs": "npx supabase db query --linked --file scripts/probe_desktop_read_rpcs.sql",
    "db:verify-functions": "npx supabase db query --linked --file scripts/verify_live_functions.sql",
    "db:verify-functions:local": "npx supabase db query --local --file scripts/verify_live_functions.sql",
    "db:audit-schema": "npx supabase db query --linked --file scripts/audit_live_schema_inventory.sql -o json",
    "db:test-phase1-modules": "npx supabase db query --linked --file scripts/test_phase1_factory_modules.sql",
    "db:test-phase2-mm-schema": "npx supabase db query --linked --file scripts/test_phase2_mm_schema.sql",
    "lint:module-boundaries": "node scripts/check-module-boundaries.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "date-fns": "^4.1.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-date-range": "^2.0.1",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@types/node": "^22.14.0",
    "@types/react-date-range": "^1.4.10",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
